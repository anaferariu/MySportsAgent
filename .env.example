# Copy to .env and run with: node --env-file=.env server/index.js
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this
# Search engine: "rules" (default, regex-based, free) or "agent" (Claude, needs an API key).
SEARCH_ENGINE=rules
# Only used when SEARCH_ENGINE=agent.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
